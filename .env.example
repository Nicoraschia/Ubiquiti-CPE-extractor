# Copiar a .env (no se commitea) y completar.
POSTGRES_USER=cpe
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=cpe

# Credenciales SSH de los equipos airOS. Si quedan vacias, el scanner las pide.
# Se prueban en orden (1, 2, ...); cada equipo recuerda cual le funciono.
SCAN_USER=
SCAN_PASSWORD=
SCAN_USER_2=
SCAN_PASSWORD_2=

# Opcional: token Bearer para scripts contra la API (actua como admin). La web no lo usa.
# Generar con: head -c 32 /dev/urandom | base64 | tr -dc A-Za-z0-9
API_TOKEN=

# Nombre o IP con el que se entra a la web (Caddy saca el certificado con su CA interna).
SITE_HOST=192.168.64.5

# Cada cuantos minutos el worker escanea todas las subnets habilitadas. 0 = solo manual.
SCAN_INTERVAL_MIN=60
